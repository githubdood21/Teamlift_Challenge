# Local PostgreSQL example. For Render, replace this with the external URL locally
# (append ?sslmode=require), or the internal URL on a Render service in the same region.
DATABASE_URL=postgresql://teamlift:teamlift@localhost:5432/teamlift

# Host-only calendar setup. Set a random admin key (at least 32 characters).
HOST_ADMIN_KEY=
# 32 random bytes as 64 hexadecimal characters. Keep stable after connecting.
CALENDAR_TOKEN_ENCRYPTION_KEY=
APP_ORIGIN=http://localhost:5173

# Google Cloud Web application OAuth client. See docs/GOOGLE_CALENDAR.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local value to enter: http://localhost:3000/api/calendar/callback
GOOGLE_REDIRECT_URI=

# Optional booking confirmation. Get an API key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
